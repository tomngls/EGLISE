{
  
  "name": "eglise",
  "main": "./worker.js",
  "compatibility_date": "2026-08-14",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eglise-db",
      "database_id": "11676f76-bc68-43b9-a86e-139ba3a31634"
    }
  ]
}